# Copy this file to .env and fill in. Never commit .env.
#
# LLM_PROVIDER options:
#   none               -> no answer generator; the app shows the most relevant document passages (default)
#   anthropic          -> Anthropic Messages API
#   openai_compatible  -> any OpenAI-style /chat/completions endpoint (OpenAI, Gemini's OpenAI-compatible
#                         endpoint, a local Ollama server, ...)
LLM_PROVIDER=none
LLM_API_KEY=
# Anthropic default: claude-sonnet-5-5. For openai_compatible you must set a model name yourself.
LLM_MODEL=
# Only for openai_compatible. Examples:
#   OpenAI : https://api.openai.com/v1
#   Gemini : https://generativelanguage.googleapis.com/v1beta/openai
#   Ollama : http://localhost:11434/v1
LLM_BASE_URL=
